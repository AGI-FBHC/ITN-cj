package web.service

// Original Java onboarding lists and quiz-bank.json, retained without assessment algorithms.
public class OnboardingStaticData {
    public static let tagsJson: String = "[\"在校学生\",\"应届毕业生\",\"职场新人（1-3年）\",\"中级工程师（3-5年）\",\"高级工程师（5年+）\",\"转岗/跨领域\",\"自由学习者\"]"
    public static let eduJson: String = "[\"初中及以下\",\"高中\",\"大专\",\"本科\",\"硕士\",\"博士\"]"
    public static let stylesJson: String = "[\"理论先行\",\"实操驱动\",\"图示学习\",\"案例迁移\",\"步骤清单\",\"碎片化学习\",\"视频演示\",\"项目实战\",\"同伴讨论\"]"
    public static let selfLevelsJson: String = "[\"未接触\",\"需要指导\",\"可独立完成\",\"能处理复杂情况\",\"能指导他人\"]"
    public static let questionsJson: String = "[{\"id\":\"q-01\",\"kpId\":\"kp-ds\",\"level\":\"basic\",\"stars\":1,\"stem\":\"在 Agent 工具调用中，JSON Schema 的主要作用是：\",\"options\":[\"训练一个新的大模型\",\"描述工具参数的字段、类型和约束，便于模型正确构造调用\",\"替代工具的业务实现\",\"保存全部对话历史\"],\"answerIndex\":1,\"analysis\":\"工具 Schema 是模型与外部能力之间的参数契约，清晰的字段和约束能减少无效调用。\",\"kbRefs\":[\"KB-DS-01\"]},{\"id\":\"q-02\",\"kpId\":\"kp-ds\",\"level\":\"basic\",\"stars\":1,\"stem\":\"程序把近期常用数据放入缓存，主要想利用的是：\",\"options\":[\"数据访问具有局部性\",\"磁盘容量会自动增大\",\"网络请求不会超时\",\"数据库不再需要索引\"],\"answerIndex\":0,\"analysis\":\"缓存依赖时间或空间局部性，用更快的存储承接高频访问数据。\",\"kbRefs\":[\"KB-DS-01\"]},{\"id\":\"q-03\",\"kpId\":\"kp-ds\",\"level\":\"advanced\",\"stars\":2,\"stem\":\"关于进程、线程和协程，下列理解最准确的是：\",\"options\":[\"它们只是三种不同名称\",\"它们处于不同抽象层次，资源隔离与调度成本通常不同\",\"协程一定比线程快\",\"线程之间完全不共享资源\"],\"answerIndex\":1,\"analysis\":\"理解概念需要抓住抽象层次、资源边界与调度方式，不能只记结论或绝对比较。\",\"kbRefs\":[\"KB-DS-02\"]},{\"id\":\"q-04\",\"kpId\":\"kp-ds\",\"level\":\"challenge\",\"stars\":3,\"stem\":\"同一概念在文档、代码和日志中使用了不同名称。要确认它们是否指向同一对象，最可靠的是：\",\"options\":[\"只比较名称是否相似\",\"比较定义、输入输出、生命周期和实际行为\",\"默认它们完全相同\",\"只看出现次数\"],\"answerIndex\":1,\"analysis\":\"深入理解概念要比较定义边界和可观察行为，不能只依赖术语表面。\",\"kbRefs\":[\"KB-DS-03\"]},{\"id\":\"q-05\",\"kpId\":\"kp-co\",\"level\":\"basic\",\"stars\":1,\"stem\":\"一个 Agent 按“观察→判断是否需要工具→调用工具→读取结果→继续回答”运行。工具返回后最合理的下一步是：\",\"options\":[\"忽略工具结果并重复原回答\",\"把工具结果作为新观察，判断是否已有足够证据或需要继续行动\",\"立即结束所有会话\",\"重新训练模型\"],\"answerIndex\":1,\"analysis\":\"Agent 循环需要把行动结果反馈为新观察，再基于当前证据决定继续调用或生成最终答案。\",\"kbRefs\":[\"KB-CO-01\"]},{\"id\":\"q-06\",\"kpId\":\"kp-co\",\"level\":\"basic\",\"stars\":1,\"stem\":\"规则为“只有已登录且拥有编辑权限才能保存”。哪种情况一定不能保存？\",\"options\":[\"已登录且有编辑权限\",\"已登录但没有编辑权限\",\"已登录、权限未知\",\"登录状态和权限都未知\"],\"answerIndex\":1,\"analysis\":\"保存条件是两个条件同时成立；缺少编辑权限时，无论其他条件如何都不能保存。\",\"kbRefs\":[\"KB-CO-02\"]},{\"id\":\"q-07\",\"kpId\":\"kp-co\",\"level\":\"advanced\",\"stars\":2,\"stem\":\"一个循环每次把问题规模减半，直到规模为 1。它的执行次数量级是：\",\"options\":[\"O(1)\",\"O(log n)\",\"O(n)\",\"O(n²)\"],\"answerIndex\":1,\"analysis\":\"连续减半约需 log₂n 次，考查从过程推导复杂度，而非记忆某个算法名称。\",\"kbRefs\":[\"KB-CO-03\"]},{\"id\":\"q-08\",\"kpId\":\"kp-co\",\"level\":\"challenge\",\"stars\":3,\"stem\":\"若 A 必须先于 B，B 与 C 可并行，D 必须等 B、C 都完成后执行，合法顺序是：\",\"options\":[\"B→D→A→C\",\"A→B→C→D\",\"C→D→A→B\",\"D→A→B→C\"],\"answerIndex\":1,\"analysis\":\"A→B 满足前置约束，C 可在其间完成，最后执行等待 B、C 的 D。\",\"kbRefs\":[\"KB-CO-04\"]},{\"id\":\"q-09\",\"kpId\":\"kp-os\",\"level\":\"basic\",\"stars\":1,\"stem\":\"你为 Agent 新增了一个“查询订单”工具，最合理的首次验证方式是：\",\"options\":[\"直接让真实用户使用\",\"分别测试正常参数、缺失参数和无权限场景，并检查 Agent 是否正确使用返回结果\",\"只确认工具名称能显示\",\"只测试模型能否输出一段自然语言\"],\"answerIndex\":1,\"analysis\":\"Agent 工具验证既要检查接口边界，也要检查模型是否能正确选择、调用并消费工具结果。\",\"kbRefs\":[\"KB-OS-01\"]},{\"id\":\"q-10\",\"kpId\":\"kp-os\",\"level\":\"advanced\",\"stars\":2,\"stem\":\"修复缺陷并准备提交代码时，哪套流程更可靠？\",\"options\":[\"修改后立即提交\",\"只看页面是否能打开\",\"复现问题、修改、执行相关测试、检查差异后提交\",\"删除失败测试\"],\"answerIndex\":2,\"analysis\":\"可靠交付需要可复现、针对性修改、验证和差异审查形成闭环。\",\"kbRefs\":[\"KB-OS-02\"]},{\"id\":\"q-11\",\"kpId\":\"kp-os\",\"level\":\"basic\",\"stars\":1,\"stem\":\"调用接口返回 JSON，但字段不符合预期。下一步最有效的是：\",\"options\":[\"反复刷新页面\",\"查看接口契约、实际请求参数和响应内容并构造最小复现\",\"立即重装操作系统\",\"忽略该字段\"],\"answerIndex\":1,\"analysis\":\"工程实践强调依据接口契约和真实输入输出构造最小复现，再定位前后端责任。\",\"kbRefs\":[\"KB-OS-03\"]},{\"id\":\"q-12\",\"kpId\":\"kp-os\",\"level\":\"challenge\",\"stars\":3,\"stem\":\"一次数据库迁移涉及结构变更和数据回填，较稳妥的执行方案是：\",\"options\":[\"直接在生产执行且不备份\",\"先在等价环境演练，准备校验和回滚方案，再分批执行\",\"只修改前端展示\",\"执行失败后删除数据库\"],\"answerIndex\":1,\"analysis\":\"复杂工程操作应通过演练、校验、分批与回滚控制风险。\",\"kbRefs\":[\"KB-OS-04\"]},{\"id\":\"q-13\",\"kpId\":\"kp-network\",\"level\":\"basic\",\"stars\":1,\"stem\":\"Agent 调用外部工具持续返回 401，但普通对话正常。首先应检查：\",\"options\":[\"模型回答的语气\",\"工具请求使用的凭证、权限范围和鉴权头\",\"知识库文档标题\",\"聊天窗口颜色\"],\"answerIndex\":1,\"analysis\":\"普通对话正常而工具返回 401，故障范围集中在工具侧鉴权，应先核对凭证和权限。\",\"kbRefs\":[\"KB-NET-01\"]},{\"id\":\"q-14\",\"kpId\":\"kp-network\",\"level\":\"basic\",\"stars\":1,\"stem\":\"接口响应变慢，但 CPU 正常、数据库慢查询明显增加。最合理的排查方向是：\",\"options\":[\"更换页面颜色\",\"分析慢 SQL、执行计划和索引命中情况\",\"增加登录按钮\",\"清空所有业务数据\"],\"answerIndex\":1,\"analysis\":\"已有证据指向数据库访问，应沿慢 SQL、执行计划和索引继续验证假设。\",\"kbRefs\":[\"KB-NET-02\"]},{\"id\":\"q-15\",\"kpId\":\"kp-network\",\"level\":\"advanced\",\"stars\":2,\"stem\":\"服务内存持续上涨。哪种做法最能区分“正常缓存增长”和“内存泄漏”？\",\"options\":[\"只重启一次服务\",\"持续观察内存、对象数量与 GC 后存活对象，并结合流量做对照\",\"修改服务名称\",\"关闭日志\"],\"answerIndex\":1,\"analysis\":\"诊断需要趋势和对照证据；GC 后存活对象持续累积更支持泄漏假设。\",\"kbRefs\":[\"KB-NET-03\"]},{\"id\":\"q-16\",\"kpId\":\"kp-network\",\"level\":\"challenge\",\"stars\":3,\"stem\":\"某故障只在高并发时出现。最有效的验证方法是：\",\"options\":[\"在低流量下刷新一次\",\"构造可控并发压测，同时采集请求链路、资源和错误日志\",\"修改错误提示文案\",\"凭经验直接改代码\"],\"answerIndex\":1,\"analysis\":\"并发故障需要在可控条件下复现，并同步采集链路与资源证据来定位竞争点。\",\"kbRefs\":[\"KB-NET-04\"]},{\"id\":\"q-17\",\"kpId\":\"kp-db\",\"level\":\"basic\",\"stars\":1,\"stem\":\"Agent 内容生成耗时数分钟，还要支持进度查询和失败重试，较合理的设计是：\",\"options\":[\"让浏览器始终等待同一个同步请求\",\"创建持久化任务，由后台工作器执行，并提供状态查询与幂等重试\",\"前端倒计时结束后直接显示成功\",\"每次刷新都创建一个新任务\"],\"answerIndex\":1,\"analysis\":\"长时间 Agent 任务需要任务状态、后台执行、查询接口和安全重试，不能依赖前端模拟。\",\"kbRefs\":[\"KB-DB-01\"]},{\"id\":\"q-18\",\"kpId\":\"kp-db\",\"level\":\"advanced\",\"stars\":2,\"stem\":\"读取量很大且允许数据短暂延迟，较合理的架构选择是：\",\"options\":[\"所有请求都加全局锁\",\"引入缓存，并明确失效与一致性策略\",\"取消数据库\",\"每次读取都扫描全部数据\"],\"answerIndex\":1,\"analysis\":\"允许短暂延迟时可用缓存换取读取能力，但必须同时设计失效与一致性边界。\",\"kbRefs\":[\"KB-DB-02\"]},{\"id\":\"q-19\",\"kpId\":\"kp-db\",\"level\":\"advanced\",\"stars\":2,\"stem\":\"耗时任务需要支持后台执行、进度查询和失败重试，较完整的设计是：\",\"options\":[\"让浏览器一直等待一个长请求\",\"任务表记录状态，后台工作器执行，并提供查询与幂等重试\",\"前端用定时器伪造完成\",\"失败后创建无限个新任务\"],\"answerIndex\":0,\"analysis\":\"后台任务应有可持久化状态、执行者、进度接口和安全重试机制。\",\"kbRefs\":[\"KB-DB-03\"]},{\"id\":\"q-20\",\"kpId\":\"kp-db\",\"level\":\"challenge\",\"stars\":3,\"stem\":\"系统需要保证核心写入成功后再异步发送通知，较可靠的设计是：\",\"options\":[\"主事务提交后由页面随机触发通知\",\"用事务消息或 Outbox 记录事件，再由消费者幂等发送\",\"把通知与写入都交给前端\",\"忽略发送失败\"],\"answerIndex\":1,\"analysis\":\"Outbox 或事务消息能协调核心数据与异步事件，消费者幂等可支持安全重试。\",\"kbRefs\":[\"KB-DB-04\"]},{\"id\":\"q-21\",\"kpId\":\"kp-agent\",\"level\":\"basic\",\"stars\":1,\"stem\":\"第一次接触新的 Agent SDK，需要在一天内接入一个工具。更有效的起步方式是：\",\"options\":[\"从头背完整 API 列表\",\"运行官方最小工具调用示例，再逐步替换 Schema、实现和测试输入\",\"直接复制来源不明的完整项目\",\"先实现多智能体平台的所有功能\"],\"answerIndex\":1,\"analysis\":\"从可运行的官方最小示例出发，通过小步替换和验证迁移已有开发经验，风险最低。\",\"kbRefs\":[\"KB-AGENT-01\"]},{\"id\":\"q-22\",\"kpId\":\"kp-agent\",\"level\":\"basic\",\"stars\":1,\"stem\":\"你熟悉 REST 接口，现在要学习一种新的 RPC 框架。最可迁移的已有知识是：\",\"options\":[\"某个页面的颜色值\",\"请求响应契约、序列化、错误处理和超时等通信概念\",\"某次项目的文件夹名称\",\"只记住一个命令\"],\"answerIndex\":1,\"analysis\":\"迁移学习应提取跨技术不变的概念，再理解新框架如何实现这些概念。\",\"kbRefs\":[\"KB-AGENT-01\"]},{\"id\":\"q-23\",\"kpId\":\"kp-agent\",\"level\":\"advanced\",\"stars\":2,\"stem\":\"新工具的效果与文档描述不一致，最合理的学习策略是：\",\"options\":[\"立即断定文档错误\",\"记录版本和环境，设计最小对照实验，再查官方变更记录\",\"不断随机修改参数\",\"跳过验证直接用于生产\"],\"answerIndex\":1,\"analysis\":\"面对陌生差异，应控制变量、记录环境并查证权威资料，把经验转化为可复用结论。\",\"kbRefs\":[\"KB-AGENT-02\"]},{\"id\":\"q-24\",\"kpId\":\"kp-agent\",\"level\":\"challenge\",\"stars\":3,\"stem\":\"把在单体应用中学到的事务处理迁移到分布式服务时，首先应意识到：\",\"options\":[\"原方案无需任何变化\",\"跨服务不再共享单一本地事务，需要重新设计一致性与补偿\",\"所有事务概念都失效\",\"只要增加服务器即可\"],\"answerIndex\":1,\"analysis\":\"迁移已有知识时既要保留一致性目标，也要识别运行边界变化带来的新约束。\",\"kbRefs\":[\"KB-AGENT-03\"]}]"
}
