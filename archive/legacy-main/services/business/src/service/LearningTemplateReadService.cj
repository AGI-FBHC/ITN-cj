package web.service
import std.unicode.*
import stdx.encoding.json.*
import web.config.DatabaseConfig
import web.database.DbTransaction
import web.domain.User
import web.security.AuthUtilities
// Original AdminResourceService.listTemplates SQL filters, preserved for progress-page reads.
public class LearningTemplateReadService {
    private let database: DatabaseConfig
    public init(database: DatabaseConfig) { this.database = database }
    public func list(user: User, requested: Option<String>): String {
        if (user.getOrganizationId().isNone()) { return "{\"items\":[],\"total\":0}" }
        let org = AuthUtilities.uuidSql(user.getOrganizationId().getOrThrow())
        let domain = requested.getOrDefault({ => "" }).trim()
        let resourceFilter = if (domain.isEmpty()) { "" } else { " AND r.domain_code = " + AuthUtilities.text(domain) + " COLLATE utf8mb4_unicode_ci" }
        let presentationFilter = if (domain.isEmpty()) { "" } else { " AND p.domain_code = " + AuthUtilities.text(domain) + " COLLATE utf8mb4_unicode_ci" }
        let sql = "SELECT * FROM (" + resources.replace("@ORG@", org) + resourceFilter + " UNION ALL " +
            presentations.replace("@ORG@", org) + presentationFilter + ") catalog ORDER BY updatedAt DESC"
        return DbTransaction.run<String>(database, { tx =>
            let items = JsonArray()
            for (row in tx.query(sql)) { items.add(JsonValue.fromStr(ProfileJson.row(["id", "type", "title", "topic", "domainCode", "nodeCode", "groupName", "createdAt", "updatedAt"], row, []))) }
            return "{\"items\":" + items.toString() + ",\"total\":${items.getItems().size}}"
        })
    }
    private static let resources: String = "\r\n                SELECT BIN_TO_UUID(r.id) id, r.resource_type type, r.title, r.topic,\r\n                       r.domain_code domainCode, r.category_node_code nodeCode,\r\n                       JSON_UNQUOTE(JSON_EXTRACT(r.context_json,'\$.resourceGroup')) groupName,\r\n                       DATE_FORMAT(r.created_at, '%Y-%m-%dT%H:%i:%s.%fZ') createdAt, DATE_FORMAT(r.updated_at, '%Y-%m-%dT%H:%i:%s.%fZ') updatedAt\r\n                FROM generated_learning_resources r\r\n                WHERE r.organization_id=@ORG@\r\n                  AND r.resource_scope='ORGANIZATION'\r\n                  AND r.archived_at IS NULL\r\n                  AND (\r\n                    EXISTS (\r\n                      SELECT 1 FROM generated_learning_resources marker\r\n                      WHERE marker.organization_id=r.organization_id\r\n                        AND BINARY marker.domain_code=BINARY r.domain_code\r\n                        AND BINARY marker.category_node_code=BINARY r.category_node_code\r\n                        AND BINARY COALESCE(marker.resource_group,'默认分组')=BINARY COALESCE(r.resource_group,'默认分组')\r\n                        AND marker.resource_scope='ORGANIZATION'\r\n                        AND marker.is_template=1\r\n                        AND marker.archived_at IS NULL\r\n                    )\r\n                    OR EXISTS (\r\n                      SELECT 1 FROM presentation_tasks marker\r\n                      WHERE marker.organization_id=r.organization_id\r\n                        AND BINARY marker.domain_code=BINARY r.domain_code\r\n                        AND BINARY marker.category_node_code=BINARY r.category_node_code\r\n                        AND BINARY COALESCE(marker.resource_group,'默认分组')=BINARY COALESCE(r.resource_group,'默认分组')\r\n                        AND marker.resource_scope='ORGANIZATION'\r\n                        AND marker.is_template=1\r\n                        AND marker.archived_at IS NULL\r\n                    )\r\n                  )\r\n                "
    private static let presentations: String = "\r\n                SELECT BIN_TO_UUID(p.id) id, 'ppt' type, p.title,\r\n                       COALESCE(JSON_UNQUOTE(JSON_EXTRACT(p.request_json,'\$.generationContext.topicName')),\r\n                                JSON_UNQUOTE(JSON_EXTRACT(p.request_json,'\$.generationContext.current.topicName')),\r\n                                p.title) topic,\r\n                       p.domain_code domainCode, p.category_node_code nodeCode,\r\n                       COALESCE(p.resource_group,\r\n                                JSON_UNQUOTE(JSON_EXTRACT(p.request_json,'\$.generationContext.groupName'))) groupName,\r\n                       DATE_FORMAT(p.created_at, '%Y-%m-%dT%H:%i:%s.%fZ') createdAt, DATE_FORMAT(p.updated_at, '%Y-%m-%dT%H:%i:%s.%fZ') updatedAt\r\n                FROM presentation_tasks p\r\n                WHERE p.organization_id=@ORG@\r\n                  AND p.resource_scope='ORGANIZATION'\r\n                  AND p.archived_at IS NULL\r\n                  AND p.status='completed'\r\n                  AND (\r\n                    EXISTS (\r\n                      SELECT 1 FROM generated_learning_resources marker\r\n                      WHERE marker.organization_id=p.organization_id\r\n                        AND BINARY marker.domain_code=BINARY p.domain_code\r\n                        AND BINARY marker.category_node_code=BINARY p.category_node_code\r\n                        AND BINARY COALESCE(marker.resource_group,'默认分组')=BINARY COALESCE(p.resource_group,'默认分组')\r\n                        AND marker.resource_scope='ORGANIZATION'\r\n                        AND marker.is_template=1\r\n                        AND marker.archived_at IS NULL\r\n                    )\r\n                    OR EXISTS (\r\n                      SELECT 1 FROM presentation_tasks marker\r\n                      WHERE marker.organization_id=p.organization_id\r\n                        AND BINARY marker.domain_code=BINARY p.domain_code\r\n                        AND BINARY marker.category_node_code=BINARY p.category_node_code\r\n                        AND BINARY COALESCE(marker.resource_group,'默认分组')=BINARY COALESCE(p.resource_group,'默认分组')\r\n                        AND marker.resource_scope='ORGANIZATION'\r\n                        AND marker.is_template=1\r\n                        AND marker.archived_at IS NULL\r\n                    )\r\n                  )\r\n                "
}