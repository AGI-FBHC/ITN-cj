# Copy to .env locally; replace placeholders. Never commit actual secrets.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=itn_cangjie_dev
DB_USER=YOUR_DATABASE_USER
DB_PASSWORD=REPLACE_LOCALLY
JWT_SECRET=REPLACE_WITH_SHARED_SECRET_AT_LEAST_32_BYTES
ACCESS_TOKEN_TTL_SECONDS=86400
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=YOUR_SENDER@qq.com
SMTP_PASSWORD=REPLACE_WITH_SMTP_AUTHORIZATION_CODE
EMAIL_FROM=YOUR_SENDER@qq.com
MAIL_SUBJECT_PREFIX=[ITN]
VERIFICATION_CODE_TTL_SECONDS=300
VERIFICATION_CODE_RESEND_SECONDS=60
# Set the actual addresses and shared secrets with the other backend owner.
KNOWLEDGE_CORE_URL=http://127.0.0.1:8010
KC_INTERNAL_SECRET=REPLACE_LOCALLY
AGENT_URL=http://127.0.0.1:8100
AGENT_INTERNAL_SECRET=REPLACE_LOCALLY
# Optional: override the default ../backend/data/knowledge-base/figures
# RAG_ASSET_DIR=YOUR_KNOWLEDGE_FIGURES_DIRECTORY
