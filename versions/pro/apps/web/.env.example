# Copy to .env.local before starting Vite. Local environment files are ignored.
# Browser requests use the current origin unless a build-time prefix is provided.
# VITE_API_BASE=

# Cangjie API gateway: handles /api and forwards the remaining /v1 routes.
# Replace with your actual local or remote platform address.
VITE_API_PROXY_TARGET=http://127.0.0.1:8100
VITE_AGENT_BASE=http://127.0.0.1:8100
