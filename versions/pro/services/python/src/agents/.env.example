APP_NAME=ITN Agent Service
APP_VERSION=1.0.0
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

AGENT_INTERNAL_SECRET=replace-with-a-random-secret-at-least-32-bytes
# KnowledgeCore 服务间签名密钥；KnowledgeCore、Agents、QuestionBank 使用同一随机值。
KC_INTERNAL_SECRET=
KNOWLEDGE_CORE_URL=http://itn-knowledgecore:8010
KNOWLEDGE_RESOLVE_ENABLED=true
RULE_CORE_URL=http://itn-rulecore:8201
RULE_CORE_ENABLED=false
# 首期仅记录规则命中与核验结果，不阻断现有资源生成。
RULE_CORE_MODE=observe
RULE_CORE_TIMEOUT_SECONDS=120
INTERNAL_AUTH_MAX_SKEW_SECONDS=60
AGENT_DATABASE_PATH=data/agents.db
PRESENTATION_VISUAL_REVIEW_ENABLED=true
PRESENTATION_VISUAL_REVIEW_MODEL=deepseek-chat
PRESENTATION_VISUAL_REVIEW_MAX_SLIDES=6
PRESENTATION_VISUAL_REVIEW_TIMEOUT_SECONDS=75
PRESENTATION_CONTENT_MIN_CONCURRENCY=4
PRESENTATION_CONTENT_INITIAL_CONCURRENCY=6
PRESENTATION_CONTENT_MAX_CONCURRENCY=8
PRESENTATION_CONTENT_RETRY_BUDGET=2
PRESENTATION_CONTENT_BATCH_SIZE=1
PRESENTATION_AGENDA_MAX_TOKENS=3072

LLM_PROVIDER=mock
LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com/v1
# 子服务（KnowledgeCore / RuleCore / QuestionBank）使用同一套 LLM_* 键
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_MODEL=deepseek-chat
# DeepSeek 不支持 reasoning_effort：none 表示不发送
LLM_REASONING_EFFORT=none
LLM_CONTEXT_WINDOW=131072
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# 与 Spring Boot 共享的用户 JWT 签名密钥
JWT_SECRET=
# 平台 MySQL 只读连接（agent-runs 需要读取用户画像与学习目标）
# PLATFORM_DB_URL=mysql://user:password@host:3306/itn-platform

# Tavily 联网搜索（web_search 工具，可选）
TAVILY_API_KEY=
URL_FETCH_TIMEOUT_SECONDS=20
URL_FETCH_MAX_LENGTH=12000
CHAT_TOOL_MAX_ITERATIONS=4

# 旧 MiMo 变量名（OpenAI 兼容；当前统一指向 DeepSeek，MIMO_* 优先）
OPENCODE_GO_API_KEY=
OPENCODE_GO_API_BASE=https://api.deepseek.com/v1
MIMO_TTS_API_KEY=
MIMO_TTS_API_BASE=
OPENCODE_GO_MODEL=deepseek-chat

# 文本通道：统一使用 MIMO_API_KEY（兼容 OPENCODE_GO_API_KEY）；base/model 可选覆盖
MIMO_TEXT_API_BASE=https://api.deepseek.com/v1
# MIMO_TEXT_API_KEY= # 已废弃，由 OPENCODE_GO_API_KEY 统一提供
MIMO_TEXT_MODEL=deepseek-chat
