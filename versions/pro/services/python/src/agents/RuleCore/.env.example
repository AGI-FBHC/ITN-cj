# RuleCore 独立服务配置（与 KnowledgeCore 同库，独立进程）
# 复制为 .env 并填入真实值。切勿将真实 .env 提交到 Git。

# MySQL（itn-platform 共享库）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_user
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=itn-platform

# LLM（OpenAI 兼容）
# MiMo v2.6 为推理模型：max_tokens = 推理 + 正文总预算
LLM_API_URL=http://127.0.0.1:0/v1
LLM_API_KEY=change-me
LLM_MODEL=mimo-v2.6-flash
LLM_MAX_TOKENS=16384
LLM_TIMEOUT=300
LLM_TEMPERATURE=0.2

# Rule Engine（§21，必须显式配置）
RULE_EXTRACT_CONFIDENCE_THRESHOLD=0.80
MAX_REASONING_ROUNDS=2
MAX_REVISION_RETRY=1
RULE_ENGINE_ENABLED=true
DEBUG=false

# 仅供 Agents/RuleCore 服务间调用；必须与 Agents 使用同一随机密钥。
AGENT_INTERNAL_SECRET=replace-with-a-random-secret-at-least-32-bytes
INTERNAL_AUTH_MAX_SKEW_SECONDS=60
