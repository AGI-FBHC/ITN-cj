# QuestionBank 配置示例：复制到 src/agents/.env（与 KnowledgeCore / predeal 共用）

# Knowledge Core 服务地址（唯一知识入口；未配置时解析/检索类功能不可用）
KNOWLEDGE_CORE_URL=http://localhost:8000
KNOWLEDGE_CORE_TIMEOUT=15
KNOWLEDGE_CORE_DOMAIN=agent

# T5.1 内部服务鉴权（详见 src/agents/.env.example）：
# ENV=prod 时若下列密钥命中已知占位值会拒绝启动。
ENV=dev
QB_INTERNAL_SECRET=
KC_INTERNAL_SECRET=

# 平台 MySQL（题库三张核心表所在库；与 agents/.env 的 MYSQL_* 保持一致）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=itn-platform
