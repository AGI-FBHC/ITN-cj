FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/ \
    PIP_TRUSTED_HOST=mirrors.aliyun.com

COPY src/agents/predeal /tmp/predeal
RUN pip install --no-cache-dir /tmp/predeal && rm -rf /tmp/predeal

COPY docker/knowledge-services /opt/itn-knowledge-runtime
WORKDIR /workspace/src/agents/predeal
EXPOSE 8020
CMD ["python", "/opt/itn-knowledge-runtime/run_predeal.py"]
