FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/ \
    PIP_TRUSTED_HOST=mirrors.aliyun.com

COPY src/agents/QuestionBank /tmp/questionbank
RUN pip install --no-cache-dir '/tmp/questionbank[web]' && rm -rf /tmp/questionbank

COPY docker/knowledge-services /opt/itn-knowledge-runtime
WORKDIR /workspace/src/agents/QuestionBank
EXPOSE 8030
CMD ["python", "/opt/itn-knowledge-runtime/run_questionbank.py"]
