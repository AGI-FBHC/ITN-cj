# lumin 配置示例：复制成 .env.local 再填自己的值（.env.local 已在 .gitignore 里）
# 优先级：命令行参数 > 环境变量 > ./.env.local（当前目录） > <LUMIN_HOME>/.env.local > 默认值

# ---- 模型（OpenAI 兼容）----
# 任何 OpenAI 兼容端点都行：本机 llama.cpp / Ollama / vLLM / 各家云服务商。
LUMIN_BASE=https://api.example.com/v1
LUMIN_KEY=sk-your-key
LUMIN_MODEL=gpt-4o-mini

# ---- 工作区（模型只能在这里读写、跑命令）----
# 留空 = 当前目录（Pi 的 cwd 语义）。
LUMIN_WORKSPACE=

# ---- 数据目录（会话、审批记录、权限档位、workspaces.json、skills）----
# 默认 %USERPROFILE%\.lumin
LUMIN_DATA=

# ---- 工具集档位：chat / standard / research / agent ----
LUMIN_MODE=standard

# ---- 联网检索（research 档的 web_search 工具）----
# 不填就只是"注册了但不可用"，不会报错。
LUMIN_TAVILY_KEY=
LUMIN_TAVILY_RESULTS=5

# ---- 命令行执行开关（等价于启动参数 --allow-exec）----
LUMIN_ALLOW_EXEC=
