# Copy to .env or export before starting. Do not commit real secrets.
# JWT_SECRET must match the old login issuer so existing tokens keep working.
# Put the real value in a private channel, not in shared docs.
JWT_SECRET=change-me-use-private-channel

# mysql://user:password@host:port/database — password is a placeholder.
# Spire opens this MySQL database directly (notes/categories persistence).
PLATFORM_DB_URL=mysql://itn:change-me-use-private-channel@127.0.0.1:3306/itn_platform

# HTTP listen URL.
#
# Clash Verge TUN (fake-ip) on this machine serves stale or fabricated HTTP
# on addresses it has already seen — including 127.0.0.1:8100, :18765-:18769
# and 127.0.0.2:18768 — even with no LISTENING socket. Do not trust a curl
# body alone.
#
# To verify a local Spire instance:
#   1. Pick a port Clash has never seen (example: 127.0.0.1:18801).
#   2. Confirm `netstat -ano | findstr :PORT` shows LISTENING with a PID.
#   3. Confirm a response only the current binary can produce (e.g. a route
#      you just added or removed).
#
# Old frontend: set VITE_AGENT_BASE in src/front/.env.local to the same
# address so the Vite `/v1` proxy hits Spire, e.g.
#   VITE_AGENT_BASE=http://127.0.0.1:18801
SPIRE_HTTP_URL=http://127.0.0.1:18801
